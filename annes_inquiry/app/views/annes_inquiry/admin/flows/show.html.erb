<h1><%= @flow.name %></h1>
<p><%= link_to "進行・受付一覧", admin_flow_runs_path(@flow) %></p>
<%= form_with url: admin_flow_path(@flow), method: :patch, scope: :flow, local: true do |f| %>
<p><%= f.label :name, "名前" %><%= f.text_field :name, value: @flow.name %></p>
<p><%= f.check_box :enabled, checked: @flow.enabled? %><%= f.label :enabled, "受付を有効にする" %></p><%= f.submit "設定を保存" %><% end %>
<% @flow.versions.order(number: :desc).each do |version| %><section>
<h2>版 <%= version.number %>: <%= version.title %> (<%= version.status %>)</h2>
<p><%= link_to "プレビュー", preview_admin_flow_path(@flow, version_id: version.id) %></p>
<ol><% version.steps.each do |step| %><li><%= step.title %> / <%= step.key %> / 順番 <%= step.position %> / フォーム版 <%= step.form_version_id %>
<% if version.draft? %>
<%= form_with url: edit_version_admin_flow_path(@flow, version_id: version.id), method: :patch, local: true, scope: :step do |f| %>
<%= hidden_field_tag :lock_version, version.lock_version %><%= hidden_field_tag :step_id, step.id %>
<%= f.label :title, "タイトル", for: "step_#{step.id}_title" %><%= f.text_field :title, value: step.title, id: "step_#{step.id}_title" %>
<%= f.label :position, "順番", for: "step_#{step.id}_position" %><%= f.number_field :position, value: step.position, id: "step_#{step.id}_position" %><%= f.submit "ステップを更新" %><% end %>
<%= button_to "ステップを削除", edit_version_admin_flow_path(@flow, version_id: version.id), method: :patch, params: {lock_version: version.lock_version, remove_step_id: step.id} %>
<% end %>
<%= render "rules", version: version, step: step %>
</li><% end %></ol>
<% if version.draft? %>
<%= form_with url: edit_version_admin_flow_path(@flow, version_id: version.id), method: :patch, local: true, scope: :step do |f| %>
<%= hidden_field_tag :lock_version, version.lock_version %>
<p><%= f.label :key, "ステップキー" %><%= f.text_field :key, required: true %></p>
<p><%= f.label :title, "ステップ名" %><%= f.text_field :title, required: true %></p>
<p><%= f.label :position, "順番" %><%= f.number_field :position, value: (version.steps.maximum(:position) || -1) + 1 %></p>
<p><%= f.label :form_version_id, "公開フォーム版" %><%= f.select :form_version_id, AnnesInquiry::FormVersion.joins(:form).where(annes_inquiry_forms: {follow_up_request_id: @flow.follow_up_request_id}).where(status: @flow.follow_up_request_id ? %w[draft published] : "published").includes(:form).map { |v| ["#{v.form.name} / #{v.number}", v.id] } %></p>
<%= f.submit "ステップを追加" %><% end %>
<%= button_to "公開する", publish_admin_flow_path(@flow, version_id: version.id), params: {lock_version: version.lock_version} %>
<% elsif !@flow.versions.draft.exists? %><%= button_to "次の下書きを作る", duplicate_admin_flow_path(@flow, version_id: version.id) %><% end %>
</section><% end %>
