<h1><%= @step.step.title %></h1>
<% if @input.errors.any? %><div role="alert" tabindex="-1" id="intake-errors"><%= intake_error_messages(@input).to_sentence %></div><% end %>
<%= form_with url: save_step_path(@run, step_id: @step.id), method: :patch, local: true, multipart: true, html: {novalidate: true, data: {intake_draft: true, intake_unsaved: @unsaved_input == true}} do %>
  <%= hidden_field_tag :token, @token %>
  <% mapped = @step.step.value_mappings.includes(:target_field).map(&:target_field) %>
  <% mapped.each do |field| %><p><strong><%= field.label %></strong>（前の回答から引継ぎ）: <%= intake_mapped_value(@step, field) %></p><% end %>
  <%= render "annes_intake/forms/fields", version: @step.form_version, input: @input, scope: "intake", excluded_keys: mapped.map(&:key) %>
  <% @step.form_version.fields.where(value_type: "attachment").each do |field| %>
    <%= hidden_field_tag "retained[#{field.key}][]", "" %>
    <% @step.draft_attachments.where(field: field).each do |attachment| %>
      <p><label><%= check_box_tag "retained[#{field.key}][]", attachment.id, true %> 保持する: <%= attachment.file.filename %></label>
      <%= link_to "ダウンロード", flow_attachment_path(@run, step_id: @step.id, attachment_id: attachment.id) %></p>
    <% end %>
  <% end %>
  <%= button_tag "途中保存", name: "advance", value: "0" %>
  <%= button_tag "保存して次へ", name: "advance", value: "1" %>
<% end %>
<p><%= link_to "進行状況に戻る", run_path(@run) %></p>
