<h1>受付 <%= @run.receipt_id %></h1>
<p>状態: <%= run_status(@run) %> / 定義版: <%= @run.flow_version.number %> / 期限: <%= @run.expires_at %></p>
<% @steps.each do |step| %><section><h2><%= step.step.title %> — <%= step_status(step) %></h2>
<% values = step.step_response ? @answers.fetch(step.key) : (@draft_values&.fetch(step.step_id, nil) || AnnesIntake::Flows::DraftReader.call(step)) %>
<% step.form_version.fields.each do |field| %><p><strong><%= field.label %></strong>: <%= flow_value(values[field.key], field: field) %></p><% end %>
<% files = step.step_response ? step.step_response.answers.flat_map { |answer| answer.attachments.to_a } : step.draft_attachments %>
<% files.each do |attachment| %><p><%= link_to attachment.file.filename.to_s, attachment_admin_run_path(@run, step_id: step.id, attachment_id: attachment.id, kind: step.step_response ? "answer" : "draft") %></p><% end %>
</section><% end %>
<h2>通知</h2><ul><% @run.notification_requests.each do |notification| %><li><%= notification.event_key %>: <%= intake_notification_status(notification.status) %></li><% end %></ul>
