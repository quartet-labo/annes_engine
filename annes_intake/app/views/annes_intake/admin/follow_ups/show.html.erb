<h1>追加質問 <%= @follow_up.number %>: <%= @follow_up.title %></h1>
<p>状態: <%= follow_up_status(@follow_up) %> / 期限: <%= intake_time(@follow_up.due_at) %></p>
<% version = @follow_up.definition_version %>
<p><%= link_to "質問をプレビュー", preview_admin_flow_path(version.flow, version_id: version.id) %></p>
<% if @follow_up.draft? && follow_up_allowed?(:admin_follow_up, @root) %>
<% if @follow_up.custom? %>
<p><%= link_to "質問の構成を編集", admin_flow_path(version.flow) %></p>
<ul><% version.steps.each do |step| %><li><%= link_to "#{step.title}の項目を編集", admin_version_path(step.form_version) %></li><% end %></ul>
<% end %>
<%= button_to "追加質問を発行", issue_admin_run_follow_up_path(@root, @follow_up), params: {lock_version: @follow_up.lock_version, definition_digest: @definition_digest} %>
<% end %>
<% if !@follow_up.answered? && !@follow_up.cancelled? && follow_up_allowed?(:admin_cancel_follow_up, @root) %><%= button_to "追加質問を取り消す", cancel_admin_run_follow_up_path(@root, @follow_up) %><% end %>
<p><%= link_to "初回受付に戻る", admin_run_path(@root) %></p>
