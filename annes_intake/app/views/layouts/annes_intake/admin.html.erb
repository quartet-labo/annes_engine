<!DOCTYPE html>
<html lang="ja">
<head><link rel="icon" href="data:,"><meta name="viewport" content="width=device-width, initial-scale=1"><title>受付管理</title><%= csrf_meta_tags %><%= stylesheet_link_tag "annes_intake/forms" %><%= javascript_include_tag "annes_intake/forms", defer: true %></head>
<body><main class="annes-intake intake-admin">
  <nav><%= link_to "受付", admin_runs_path %> | <%= link_to "受付フロー", admin_flows_path %> | <%= link_to "質問テンプレート", admin_forms_path %></nav>
  <% if notice.present? %><p role="status"><%= notice %></p><% end %>
  <% if alert.present? %><p role="alert" class="intake-error"><%= alert %></p><% end %>
  <%= yield %>
</main></body></html>
