<% action_path = record.persisted? ? annes_admin_resource_record_path(resource, record) : annes_admin_resource_index_path(resource) %>

<%= form_with model: record, scope: resource.param_key, url: action_path,
  class: "space-y-5 rounded-lg border border-slate-200 bg-white p-6 shadow-sm",
  data: { annes_admin_submit_guard: true } do |form| %>
  <% if record.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <p class="font-semibold">入力内容を確認してください。</p>
      <ul class="mt-2 list-disc pl-5">
        <% record.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% resource.form_fields.each do |field| %>
    <div>
      <%= form.label field.name, field.label_text, class: "block text-sm font-medium text-slate-700" %>
      <%= annes_admin_form_input(form, field) %>
    </div>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <%= form.submit "保存", class: "annes-admin-action annes-admin-action--primary rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700" %>
    <%= link_to "戻る", record.persisted? ? annes_admin_resource_record_path(resource, record) : annes_admin_resource_index_path(resource), class: "annes-admin-action annes-admin-action--secondary rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100" %>
  </div>
<% end %>
