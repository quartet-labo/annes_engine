<% content_for :title, "#{annes_admin_site_name} - 管理画面" %>

<section class="space-y-3">
  <p class="text-sm font-medium text-slate-500">Dashboard</p>
  <h1 class="text-2xl font-semibold tracking-normal text-slate-950">管理画面</h1>
  <% if @resources.present? %>
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <tbody class="divide-y divide-slate-100">
          <% @resources.each do |resource| %>
            <tr>
              <td class="px-4 py-3 font-medium text-slate-900"><%= resource.label %></td>
              <td class="px-4 py-3 text-right"><%= link_to "開く", resource_index_path(resource.route_key), class: "font-semibold text-slate-900 underline decoration-slate-300 underline-offset-2" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-slate-600">管理対象リソースはまだ登録されていません。</p>
  <% end %>
</section>
