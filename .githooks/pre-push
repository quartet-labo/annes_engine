#!/usr/bin/env sh
set -eu

protected_branch="main"

while read -r local_ref local_sha remote_ref remote_sha
do
  case "$remote_ref" in
    "refs/heads/$protected_branch")
      cat >&2 <<MSG
Direct pushes to $protected_branch are blocked.

Push a topic branch and open a pull request instead.
MSG
      exit 1
      ;;
  esac
done
