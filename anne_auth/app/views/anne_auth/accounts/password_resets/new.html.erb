<% content_for :title, "パスワード再設定" %>

<h1>パスワード再設定</h1>

<p>登録済みのメールアドレスを入力してください。パスワード再設定用のメールを送信します。</p>

<%= form_with url: auth_route(:account_password_reset_path), method: :post do |form| %>
  <div>
    <%= form.label :email, "メールアドレス" %>
    <%= form.email_field :email, autocomplete: "email", autofocus: true, required: true %>
  </div>

  <%= form.submit "送信" %>
<% end %>

<div class="auth-links">
  <%= link_to "ログインに戻る", auth_route(:account_login_path) %>
</div>
