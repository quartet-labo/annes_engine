<% content_for :title, "ログイン" %>

<h1>ログイン</h1>

<%= form_with url: auth_route(:account_session_path), method: :post do |form| %>
  <div>
    <%= form.label :email, "メールアドレス" %>
    <%= form.email_field :email, autocomplete: "email", autofocus: true, required: true %>
  </div>

  <div>
    <%= form.label :password, "パスワード" %>
    <%= form.password_field :password, autocomplete: "current-password", required: true %>
  </div>

  <%= form.submit "ログイン" %>
<% end %>

<% if AnneAuth.configuration.google_oauth_configured? %>
  <div class="auth-actions">
    <%= button_to "Googleでログイン", "/auth/google_oauth2", method: :post, data: { turbo: false }, class: "auth-secondary" %>
  </div>
<% end %>

<div class="auth-links">
  <%= link_to "アカウント作成", auth_route(:new_account_registration_path) %>
  <%= link_to "パスワードをお忘れですか？", auth_route(:new_account_password_reset_path) %>
</div>
