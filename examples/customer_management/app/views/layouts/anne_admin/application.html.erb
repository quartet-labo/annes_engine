<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || anne_admin_site_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <header>
      <div class="container topbar">
        <%= link_to anne_admin_site_name, anne_admin_dashboard_path, class: "brand" %>
        <nav class="nav" aria-label="管理メニュー">
          <%= link_to "Dashboard", anne_admin_dashboard_path %>
          <% anne_admin_resources.each do |resource| %>
            <%= link_to resource.label, anne_admin_resource_index_path(resource) %>
          <% end %>
          <% if anne_admin_current_user %>
            <%= button_to "ログアウト", main_app.admin_logout_path, method: :delete, class: "button secondary" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="container main">
      <% if notice.present? %>
        <div class="notice"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="alert"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
