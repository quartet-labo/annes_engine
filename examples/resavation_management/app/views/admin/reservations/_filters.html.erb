<%= form_with url: admin_reservation_schedule_path, method: :get, class: "filters", local: true do |form| %>
  <div>
    <%= form.label :date, "日付" %>
    <%= form.date_field :date, value: @filter.date.iso8601 %>
  </div>

  <div>
    <%= form.label :reservation_resource_id, "予約対象" %>
    <%= form.select :reservation_resource_id,
      options_from_collection_for_select(@reservation_resources, :id, :name, params[:reservation_resource_id]),
      { include_blank: "すべて" } %>
  </div>

  <div>
    <%= form.label :status, "状態" %>
    <%= form.select :status,
      options_for_select([["取消以外", ""], ["すべて", "all"]] + Reservation::STATUS_LABELS.map { |value, label| [label, value] }, params[:status]) %>
  </div>

  <div>
    <%= form.label :q, "顧客・予約番号" %>
    <%= form.search_field :q, value: params[:q], placeholder: "氏名、連絡先、予約番号" %>
  </div>

  <div class="filter-submit">
    <%= form.submit "絞り込む" %>
  </div>
<% end %>
