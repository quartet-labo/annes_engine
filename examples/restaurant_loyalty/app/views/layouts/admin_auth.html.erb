<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>飲食店ポイントカード demo</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
  </head>
  <body>
    <% if flash[:notice].present? %>
      <p><%= flash[:notice] %></p>
    <% end %>
    <% if flash[:alert].present? %>
      <p><%= flash[:alert] %></p>
    <% end %>
    <%= yield %>
  </body>
</html>
