<!DOCTYPE html>
<html lang="ja">
  <head>
    <title>飲食店ポイントカード demo</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
  </head>
  <body>
    <% if notice.present? %>
      <p class="flash flash-notice"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p class="flash flash-alert"><%= alert %></p>
    <% end %>
    <%= yield %>
  </body>
</html>
