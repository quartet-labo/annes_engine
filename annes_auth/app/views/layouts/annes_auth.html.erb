<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "アカウント" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <style>
      :root {
        color-scheme: light;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #1f2933;
        background: #f6f8fb;
      }

      body {
        margin: 0;
      }

      .auth-page {
        box-sizing: border-box;
        min-height: 100vh;
        padding: 48px 16px;
        display: grid;
        place-items: center;
      }

      .auth-panel {
        width: min(100%, 440px);
        box-sizing: border-box;
        background: #ffffff;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        padding: 28px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
      }

      h1 {
        margin: 0 0 20px;
        font-size: 1.6rem;
        line-height: 1.3;
      }

      p {
        margin: 0 0 16px;
        line-height: 1.7;
      }

      form > div {
        margin-bottom: 16px;
      }

      label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
      }

      input[type="email"],
      input[type="password"],
      input[type="text"] {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid #bcccdc;
        border-radius: 6px;
        padding: 10px 12px;
        font: inherit;
      }

      input[type="submit"],
      button,
      .auth-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        border: 0;
        border-radius: 6px;
        padding: 0 16px;
        background: #2563eb;
        color: #ffffff;
        font: inherit;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
      }

      input[type="submit"]:disabled,
      button:disabled {
        opacity: 0.6;
        cursor: wait;
      }

      .auth-secondary {
        background: #e5e7eb;
        color: #1f2933;
      }

      .auth-links,
      .auth-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        margin-top: 18px;
      }

      .auth-flash {
        box-sizing: border-box;
        width: min(100%, 440px);
        margin-bottom: 12px;
        border-radius: 6px;
        padding: 10px 12px;
        line-height: 1.6;
      }

      .auth-flash-notice {
        background: #e6f4ea;
        color: #1e4620;
      }

      .auth-flash-alert {
        background: #fdecea;
        color: #8a1c1c;
      }

      .auth-errors {
        margin: 0 0 18px;
        border-radius: 6px;
        padding: 12px 14px;
        background: #fdecea;
        color: #8a1c1c;
      }

      .auth-errors ul {
        margin: 8px 0 0;
        padding-left: 20px;
      }
    </style>
  </head>

  <body>
    <main class="auth-page">
      <div>
        <%= render "layouts/annes_auth/flash" %>
        <section class="auth-panel">
          <%= yield %>
        </section>
      </div>
    </main>
    <%= render "layouts/annes_auth/submit_guard" %>
  </body>
</html>
